# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase Postgres connection string (Project Settings > Database > Connection string).
# Use the "Session pooler" or "Direct connection" string, not the transaction pooler (port 6543),
# because the app and tests use schemas and prepared statements.
DATABASE_URL=postgresql://postgres.<project-ref>:<YOUR-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Set to true only if Node cannot verify Supabase's TLS certificate on your network.
DATABASE_SSL_NO_VERIFY=false

# Set to false to close public clinic sign-up after your clinics are registered.
ALLOW_CLINIC_SIGNUP=true

# Email for new clinic sign-ups (optional). Without SMTP_HOST, no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Who gets the "new clinic registered" email. Required for the notification to be sent.
CLINIC_SIGNUP_NOTIFY_TO=<email-address>@gmail.com
